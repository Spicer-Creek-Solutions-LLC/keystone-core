# Keystone Core DNF/YUM repository — https://repos.keystone-core.io
#
# v0.1–v0.7: the repository is UNSIGNED — matching the unsigned release
# posture (RELEASE-PLAYBOOK §6). Integrity is TLS-to-repos.keystone-core.io;
# the same trust level as the direct-download `.rpm` + `sha256sum -c` path,
# with `dnf install` convenience on top. Install to
# /etc/yum.repos.d/keystone-core.repo, then: sudo dnf install kscore-cli
#
# v0.8+ (signed): the repository gains a GPG signature. Set
# repo_gpgcheck=1 and add
#   gpgkey=https://repos.keystone-core.io/keystone-core-archive-keyring.asc
[keystone-core]
name=Keystone Core
baseurl=https://repos.keystone-core.io/rpm/stable/$basearch
enabled=1
gpgcheck=0
repo_gpgcheck=0
