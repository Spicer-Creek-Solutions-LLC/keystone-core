<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keystone Core Agent - File Components
  Defines the files to be installed
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <!-- Main product files -->
    <ComponentGroup Id="ProductComponents" Directory="BinFolder">

      <!-- Agent executable -->
      <Component Id="AgentExecutable" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
        <File Id="kscore_agent_exe"
              Name="kscore-agent.exe"
              Source="$(var.BuildOutputDir)\kscore-agent.exe"
              KeyPath="yes"
              Vital="yes">
          <!-- Optional: Add file signature verification -->
          <!-- <DigitalSignature /> -->
        </File>
      </Component>

      <!-- kscorectl CLI (optional, for local management) -->
      <Component Id="KscorectlExecutable" Guid="C2D3E4F5-A6B7-8901-CDEF-234567890123">
        <File Id="kscorectl_exe"
              Name="kscorectl.exe"
              Source="$(var.BuildOutputDir)\kscorectl.exe"
              KeyPath="yes" />
      </Component>

      <!-- State CLI plugin -->
      <Component Id="StatePlugin" Guid="D3E4F5A6-B7C8-9012-DEF0-345678901234">
        <File Id="kscore_state_exe"
              Name="kscore-state.exe"
              Source="$(var.BuildOutputDir)\kscore-state.exe"
              KeyPath="yes" />
      </Component>

      <!-- Exec CLI plugin -->
      <Component Id="ExecPlugin" Guid="E4F5A6B7-C8D9-0123-EF01-456789012345">
        <File Id="kscore_exec_exe"
              Name="kscore-exec.exe"
              Source="$(var.BuildOutputDir)\kscore-exec.exe"
              KeyPath="yes" />
      </Component>

      <!-- README file -->
      <Component Id="ReadmeFile" Guid="F5A6B7C8-D9E0-1234-F012-567890123456">
        <File Id="readme_txt"
              Name="README.txt"
              Source="assets\README.txt"
              KeyPath="yes" />
      </Component>

      <!-- License file -->
      <Component Id="LicenseFile" Guid="A6B7C8D9-E0F1-2345-0123-678901234567">
        <File Id="license_txt"
              Name="LICENSE.txt"
              Source="..\..\LICENSE"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- Configuration files -->
    <ComponentGroup Id="ConfigComponents" Directory="CONFIGFOLDER">

      <!-- Default configuration template (only if not exists) -->
      <Component Id="ConfigTemplate" Guid="B7C8D9E0-F1A2-3456-1234-789012345678"
                 NeverOverwrite="yes" Permanent="yes">
        <File Id="agent_yaml_template"
              Name="agent.yaml.template"
              Source="config\agent.yaml.template"
              KeyPath="yes" />
      </Component>

      <!-- CA certificate placeholder -->
      <Component Id="CertPlaceholder" Guid="C8D9E0F1-A2B3-4567-2345-890123456789">
        <CreateFolder />
        <RemoveFolder Id="RemoveCertFolder" On="uninstall" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
