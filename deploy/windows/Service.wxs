<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keystone Core Agent - Windows Service Components
  Configures the agent as a Windows service with SCM integration
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <ComponentGroup Id="ServiceComponents" Directory="BinFolder">

      <!-- Windows Service Installation -->
      <Component Id="ServiceComponent" Guid="D9E0F1A2-B3C4-5678-3456-901234567890">

        <!-- Service installation -->
        <ServiceInstall Id="ServiceInstaller"
                        Type="ownProcess"
                        Name="KeystoneCoreAgent"
                        DisplayName="Keystone Core Agent"
                        Description="Keystone Core infrastructure management agent. Connects to control plane for remote execution and state management."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no"
                        Vital="yes">

          <!-- Service recovery options -->
          <ServiceConfig DelayedAutoStart="no"
                         OnInstall="yes"
                         OnReinstall="yes"
                         OnUninstall="no"
                         FailureActionsWhen="failedToStop" />

          <!-- Failure actions: restart on first two failures, then do nothing -->
          <Failure ResetPeriod="86400"
                   Command=""
                   RebootMessage="">
            <Action Type="restart" Delay="5000" />
            <Action Type="restart" Delay="10000" />
            <Action Type="none" Delay="0" />
          </Failure>

          <!-- Service dependencies -->
          <ServiceDependency Id="Tcpip" />

          <!-- Description for event log registration -->
          <util:EventSource xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
                            Name="KeystoneCore"
                            Log="Application"
                            EventMessageFile="[BinFolder]kscore-agent.exe"
                            CategoryMessageFile="[BinFolder]kscore-agent.exe"
                            ParameterMessageFile="[BinFolder]kscore-agent.exe"
                            SupportsErrors="yes"
                            SupportsFailureAudits="yes"
                            SupportsInformationals="yes"
                            SupportsSuccessAudits="yes"
                            SupportsWarnings="yes" />

        </ServiceInstall>

        <!-- Service control during install/uninstall -->
        <ServiceControl Id="ServiceControl"
                        Name="KeystoneCoreAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- File association for service -->
        <File Id="ServiceExecutable"
              Name="kscore-agent.exe"
              Source="$(var.BuildOutputDir)\kscore-agent.exe"
              KeyPath="yes" />

      </Component>

      <!-- Environment variables for service -->
      <Component Id="ServiceEnvironment" Guid="E0F1A2B3-C4D5-6789-4567-012345678901">
        <Environment Id="KSCORE_CONFIG_PATH"
                     Name="KSCORE_CONFIG_PATH"
                     Value="[CONFIGFOLDER]agent.yaml"
                     Permanent="no"
                     Part="all"
                     Action="set"
                     System="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- Custom actions for service configuration -->
  <Fragment>
    <CustomAction Id="GenerateConfig"
                  Directory="CONFIGFOLDER"
                  ExeCommand="[BinFolder]kscore-agent.exe --generate-config --output [CONFIGFOLDER]agent.yaml --server-url [SERVERURL] --agent-id [AGENTID] --log-level [LOGLEVEL]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="GenerateConfigRollback"
                  Directory="CONFIGFOLDER"
                  ExeCommand="cmd /c del /q [CONFIGFOLDER]agent.yaml"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Server URL validation using VBScript to prevent command injection.
      Validates that SERVERURL matches expected patterns:
      - nats://hostname:port
      - tls://hostname:port
      - nats://hostname:port,hostname:port (cluster)
    -->
    <CustomAction Id="ValidateServerUrl"
                  Script="vbscript"
                  Execute="immediate">
      <![CDATA[
        Function ValidateServerUrl()
          Dim serverUrl, regEx, errorMsg
          serverUrl = Session.Property("SERVERURL")

          ' If no SERVERURL provided, that's OK (will use defaults)
          If serverUrl = "" Then
            ValidateServerUrl = 0
            Exit Function
          End If

          ' Create regex to validate URL format
          ' Allowed: nats://host:port or tls://host:port
          ' Host can be alphanumeric, dots, dashes
          ' Port is 1-5 digits
          ' Multiple URLs separated by comma are allowed
          Set regEx = New RegExp
          regEx.Pattern = "^(nats|tls)://[a-zA-Z0-9][a-zA-Z0-9\-\.]*:[0-9]{1,5}(,(nats|tls)://[a-zA-Z0-9][a-zA-Z0-9\-\.]*:[0-9]{1,5})*$"
          regEx.IgnoreCase = True
          regEx.Global = False

          If Not regEx.Test(serverUrl) Then
            ' Check for potentially dangerous characters (command injection)
            Set dangerousChars = New RegExp
            dangerousChars.Pattern = "[&|;`$(){}[\]<>!""'\\]"
            dangerousChars.Global = True

            If dangerousChars.Test(serverUrl) Then
              errorMsg = "SERVERURL contains invalid characters. Only alphanumeric, dots, dashes, colons, and slashes are allowed."
            Else
              errorMsg = "Invalid SERVERURL format. Expected: nats://hostname:port or tls://hostname:port"
            End If

            Session.Property("SERVERURL_VALID") = "0"
            Session.Message msiMessageTypeError, errorMsg
            ValidateServerUrl = 3  ' Return error code
            Exit Function
          End If

          Session.Property("SERVERURL_VALID") = "1"
          ValidateServerUrl = 0
        End Function
      ]]>
    </CustomAction>

    <!-- Condition to ensure URL is valid before config generation -->
    <Property Id="SERVERURL_VALID" Value="0" />

    <!-- Set condition for config generation -->
    <Property Id="GENERATECONFIG" Value="1" />

    <!-- Install sequence -->
    <InstallExecuteSequence>
      <!-- Validate server URL first -->
      <Custom Action="ValidateServerUrl" Before="InstallFiles" Condition="SERVERURL" />
      <!-- Generate config after files are installed, before service starts -->
      <Custom Action="GenerateConfigRollback" After="InstallFiles" Condition="SERVERURL AND GENERATECONFIG=1 AND SERVERURL_VALID=1" />
      <Custom Action="GenerateConfig" After="GenerateConfigRollback" Condition="SERVERURL AND GENERATECONFIG=1 AND SERVERURL_VALID=1" />
    </InstallExecuteSequence>
  </Fragment>

</Wix>
