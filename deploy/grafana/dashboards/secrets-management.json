{
  "title": "Keystone Core — Secrets Management",
  "uid": "kscore-secrets-management",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["kscore", "secrets"],
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {"name": "datasource", "type": "datasource", "query": "prometheus"},
      {"name": "env", "type": "query", "datasource": {"type": "prometheus", "uid": "$datasource"}, "query": "label_values(up, env)", "includeAll": true, "allValue": ".+", "refresh": 1},
      {"name": "datacenter", "type": "query", "datasource": {"type": "prometheus", "uid": "$datasource"}, "query": "label_values(up, datacenter)", "includeAll": true, "allValue": ".+", "refresh": 1},
      {"name": "backend", "type": "query", "datasource": {"type": "prometheus", "uid": "$datasource"}, "query": "label_values(kscore_secrets_access_total, backend)", "includeAll": true, "allValue": ".+", "multi": true, "refresh": 1}
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Operations (1h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"refId": "A", "expr": "sum(increase(kscore_secrets_access_total{backend=~\"$backend\",env=~\"$env\",datacenter=~\"$datacenter\"}[1h]))"}]
    },
    {
      "id": 2,
      "title": "Error ratio (1h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"refId": "A", "expr": "sum(increase(kscore_secrets_access_total{result=\"error\",backend=~\"$backend\",env=~\"$env\",datacenter=~\"$datacenter\"}[1h])) / clamp_min(sum(increase(kscore_secrets_access_total{backend=~\"$backend\",env=~\"$env\",datacenter=~\"$datacenter\"}[1h])), 1)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.01, "color": "yellow"}, {"value": 0.05, "color": "red"}]}}}
    },
    {
      "id": 3,
      "title": "Backends in use",
      "type": "stat",
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"refId": "A", "expr": "count(count by (backend) (kscore_secrets_access_total{backend=~\"$backend\",env=~\"$env\",datacenter=~\"$datacenter\"} > 0))"}]
    },
    {
      "id": 4,
      "title": "Ops by backend",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"refId": "A", "expr": "sum by (backend) (rate(kscore_secrets_access_total{backend=~\"$backend\",env=~\"$env\",datacenter=~\"$datacenter\"}[5m]))", "legendFormat": "{{backend}}"}]
    },
    {
      "id": 5,
      "title": "Ops by op type",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"refId": "A", "expr": "sum by (op) (rate(kscore_secrets_access_total{backend=~\"$backend\",env=~\"$env\",datacenter=~\"$datacenter\"}[5m]))", "legendFormat": "{{op}}"}]
    },
    {
      "id": 6,
      "title": "Errors by backend",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"refId": "A", "expr": "sum by (backend) (rate(kscore_secrets_access_total{result=\"error\",backend=~\"$backend\",env=~\"$env\",datacenter=~\"$datacenter\"}[5m]))", "legendFormat": "{{backend}}"}]
    }
  ]
}
