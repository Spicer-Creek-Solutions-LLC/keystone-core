{
  "title": "Keystone Core — Control Plane Health",
  "uid": "kscore-control-plane-health",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["kscore", "control-plane"],
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      },
      {
        "name": "env",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": "label_values(up, env)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": false
      },
      {
        "name": "datacenter",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": "label_values(up, datacenter)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cluster quorum",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "kscore_cluster_quorum{env=~\"$env\",datacenter=~\"$datacenter\"}"}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "LOST", "color": "red"}, "1": {"text": "HEALTHY", "color": "green"}}}]}}
    },
    {
      "id": 2,
      "title": "Cluster members by state",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "kscore_cluster_members_total{env=~\"$env\",datacenter=~\"$datacenter\"}", "legendFormat": "{{state}}"}
      ]
    },
    {
      "id": 3,
      "title": "Process resident memory",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "process_resident_memory_bytes{env=~\"$env\",datacenter=~\"$datacenter\"}", "legendFormat": "rss"}
      ]
    },
    {
      "id": 4,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "go_goroutines{env=~\"$env\",datacenter=~\"$datacenter\"}", "legendFormat": "goroutines"}
      ]
    },
    {
      "id": 5,
      "title": "HTTP request rate by route",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum by (route) (rate(kscore_http_request_duration_seconds_count{env=~\"$env\",datacenter=~\"$datacenter\"}[5m]))", "legendFormat": "{{route}}"}
      ]
    },
    {
      "id": 6,
      "title": "HTTP p99 latency by route",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.99, sum by (route, le) (rate(kscore_http_request_duration_seconds_bucket{env=~\"$env\",datacenter=~\"$datacenter\"}[5m])))", "legendFormat": "{{route}}"}
      ]
    },
    {
      "id": 7,
      "title": "gRPC request rate by method",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum by (method) (rate(kscore_grpc_request_duration_seconds_count{env=~\"$env\",datacenter=~\"$datacenter\"}[5m]))", "legendFormat": "{{method}}"}
      ]
    },
    {
      "id": 8,
      "title": "Cardinality limiter — dropped per metric",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum by (metric) (increase(kscore_metrics_cardinality_total{outcome=\"dropped\",env=~\"$env\",datacenter=~\"$datacenter\"}[1h]))", "format": "table", "instant": true}
      ]
    }
  ]
}
