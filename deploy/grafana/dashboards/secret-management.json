{
  "dashboard": {
    "title": "Secret Management",
    "uid": "kscore-secrets",
    "tags": ["kscore", "secrets", "vault", "epic-28"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "backend",
          "type": "query",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "query": "label_values(kscore_secret_operations_total, backend)",
          "refresh": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*"
        }
      ]
    },
    "panels": [
      {
        "title": "Secret Operations Overview",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
        "collapsed": false
      },
      {
        "title": "Secret Reads/sec",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_operations_total{operation=\"read\",backend=~\"$backend\"}[5m]))",
            "legendFormat": "Reads/sec"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "title": "Secret Writes/sec",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_operations_total{operation=\"write\",backend=~\"$backend\"}[5m]))",
            "legendFormat": "Writes/sec"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "title": "Cache Hit Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_cache_hits_total[5m])) / (sum(rate(kscore_secret_cache_hits_total[5m])) + sum(rate(kscore_secret_cache_misses_total[5m]))) * 100",
            "legendFormat": "Hit %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "title": "Backend Latency",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(kscore_secret_operation_duration_seconds_bucket{backend=~\"$backend\"}[5m])) by (le))",
            "legendFormat": "P95"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "title": "Secret Operations by Backend",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_operations_total{backend=~\"$backend\"}[5m])) by (backend, operation)",
            "legendFormat": "{{backend}} {{operation}}"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "title": "Secret Operation Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(kscore_secret_operation_duration_seconds_bucket{backend=~\"$backend\"}[5m])) by (le, backend))",
            "legendFormat": "{{backend}} P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(kscore_secret_operation_duration_seconds_bucket{backend=~\"$backend\"}[5m])) by (le, backend))",
            "legendFormat": "{{backend}} P95"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "title": "Backend Health",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
        "collapsed": false
      },
      {
        "title": "Backend Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "sum(kscore_secret_backend_health{backend=~\"$backend\"})",
            "legendFormat": "Healthy"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "Unhealthy", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "Healthy", "color": "green"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "title": "Connection Errors",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 14},
        "targets": [
          {
            "expr": "sum(increase(kscore_secret_backend_errors_total{backend=~\"$backend\"}[1h]))",
            "legendFormat": "Errors (1h)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 20, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 14},
        "targets": [
          {
            "expr": "sum(kscore_secret_backend_connections{backend=~\"$backend\"})",
            "legendFormat": "Connections"
          }
        ]
      },
      {
        "title": "Token Renewals/sec",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 14},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_token_renewals_total{backend=~\"$backend\"}[5m]))",
            "legendFormat": "Renewals/sec"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "title": "Backend Errors Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_backend_errors_total{backend=~\"$backend\"}[5m])) by (backend, error_type)",
            "legendFormat": "{{backend}}: {{error_type}}"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "title": "Backend Response Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
        "targets": [
          {
            "expr": "avg(kscore_secret_backend_response_time_seconds{backend=~\"$backend\"}) by (backend)",
            "legendFormat": "{{backend}}"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "title": "Secret Rotation",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26},
        "collapsed": false
      },
      {
        "title": "Rotations Today",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 27},
        "targets": [
          {
            "expr": "sum(increase(kscore_secret_rotations_total[24h]))",
            "legendFormat": "Rotations"
          }
        ]
      },
      {
        "title": "Rotation Success Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 27},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_rotations_total{status=\"success\"}[24h])) / sum(rate(kscore_secret_rotations_total[24h])) * 100",
            "legendFormat": "Success %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 90, "color": "yellow"},
                {"value": 99, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "title": "Secrets Expiring Soon",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 27},
        "targets": [
          {
            "expr": "sum(kscore_secrets_expiring_soon{days=\"7\"})",
            "legendFormat": "Expiring (7d)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 20, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "title": "Expired Secrets",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 27},
        "targets": [
          {
            "expr": "sum(kscore_secrets_expired)",
            "legendFormat": "Expired"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "title": "Secret Rotation Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 31},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_rotations_total[5m])) by (secret_type)",
            "legendFormat": "{{secret_type}}"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "title": "Secret Age Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 31},
        "targets": [
          {
            "expr": "sum(kscore_secret_age_days_bucket) by (le)",
            "legendFormat": "{{le}}"
          }
        ]
      },
      {
        "title": "Access Control",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39},
        "collapsed": false
      },
      {
        "title": "Access Denied",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "sum(rate(kscore_secret_access_denied_total[5m])) by (reason)",
            "legendFormat": "{{reason}}"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      },
      {
        "title": "Secret Access by Principal",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
        "targets": [
          {
            "expr": "topk(10, sum(rate(kscore_secret_operations_total[5m])) by (principal))",
            "legendFormat": "{{principal}}"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "ops"}}
      }
    ]
  }
}
