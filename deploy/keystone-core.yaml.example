# Keystone Core Configuration Example
# This file demonstrates the available configuration options

server:
  listenaddr: "0.0.0.0"
  grpcport: 9090
  httpport: 8080

# NATS configuration
nats:
  # Mode: embedded, external, or leaf
  # - embedded: Run NATS server in-process (zero dependencies)
  # - external: Connect to external NATS cluster
  # - leaf: Run embedded NATS as leaf node connected to parent cluster
  mode: embedded

  # External NATS URL (required for external or leaf mode)
  # url: "nats://nats.example.com:4222"

  # Embedded NATS settings (for embedded or leaf mode)
  embedded:
    port: 4222
    enablejetstream: true
    storedir: "./data/nats"
    maxmemory: 1073741824  # 1GB
    maxconnections: 1000
    # Leaf node parent URLs (required for leaf mode)
    # leafnodeurls:
    #   - "nats://control-plane.example.com:7422"

  # JetStream settings
  jetstream:
    enabled: true
    storedir: "./data/jetstream"
    maxstorage: 10737418240  # 10GB

  # Connection settings
  maxreconnects: -1  # unlimited
  reconnectwait: 2s

  # Authentication (optional)
  # token: "your-token-here"
  # credential: "/path/to/nats.creds"

# Storage configuration
storage:
  # Backend: sqlite or postgresql
  # - sqlite: Embedded database (zero dependencies, <100 nodes)
  # - postgresql: Production database (100+ nodes, HA support)
  backend: sqlite

  # SQLite settings
  sqlite:
    path: "./data/keystone-core.db"
    wal: true
    busytimeout: 5000  # milliseconds

  # PostgreSQL settings (for production)
  # postgresql:
  #   dsn: "postgres://user:password@localhost:5432/kscore?sslmode=disable"
  #   maxopenconns: 25
  #   maxidleconns: 5
  #   connmaxlifetime: 5m

# Agent configuration
agent:
  # Agent ID (auto-generated if empty)
  id: ""
  heartbeatinterval: 30s
  commandtimeout: 5m
  metadatainterval: 5m

# TLS configuration
tls:
  enabled: false
  # certfile: "/path/to/cert.pem"
  # keyfile: "/path/to/key.pem"
  # cafile: "/path/to/ca.pem"
  # insecureskipverify: false

# API Authentication configuration
# SECURITY: Authentication is ENABLED by default for production safety
auth:
  # Enable/disable authentication (default: true)
  # WARNING: Setting to false allows unauthenticated access to all APIs
  enabled: true

  # Authentication type: apikey, jwt, mtls, or multi
  type: apikey

  # API Key authentication settings
  apikey:
    # HTTP header name for API key
    headername: "X-API-Key"
    # gRPC metadata key for API key
    metadatakey: "x-api-key"

    # API keys with roles
    # Key values must be at least 32 characters for security
    # Generate with: openssl rand -hex 32
    keys:
      # Admin key - full access to all operations
      "REPLACE_WITH_SECURE_KEY_AT_LEAST_32_CHARS_ADMIN":
        name: admin-key
        role: admin  # admin, operator, or readonly
        enabled: true
        # Optional expiration (RFC3339 format)
        # expiresat: "2025-12-31T23:59:59Z"

      # Operator key - can execute commands, manage agents
      # "REPLACE_WITH_SECURE_KEY_AT_LEAST_32_CHARS_OPS":
      #   name: ops-team
      #   role: operator
      #   enabled: true

      # Readonly key - view only access
      # "REPLACE_WITH_SECURE_KEY_AT_LEAST_32_CHARS_RO":
      #   name: monitoring
      #   role: readonly
      #   enabled: true

  # JWT authentication settings (for type: jwt or multi)
  # jwt:
  #   secret: "your-jwt-secret-for-hs256"
  #   # OR use public key for RS256/ES256
  #   # publickeyfile: "/path/to/public.pem"
  #   issuer: "kscore"
  #   audience: "kscore-api"
  #   roleclaim: "role"

  # mTLS authentication settings (for type: mtls or multi)
  # Requires tls.enabled=true and tls.cafile set
  # mtls:
  #   requireclientcert: true
  #   certroles:
  #     "CN=admin-client": admin
  #     "CN=ops-client": operator

  # Methods that bypass authentication (health checks, etc.)
  bypassmethods:
    - "/grpc.health.v1.Health/Check"
    - "/grpc.health.v1.Health/Watch"
