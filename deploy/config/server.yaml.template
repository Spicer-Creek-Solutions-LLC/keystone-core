# Default Keystone Core control-plane server configuration.
#
# Shipped by the kscore-server package. Single-node DEVELOPMENT-mode
# boot so `apt install kscore-server && systemctl start kscore-server`
# brings up a working server out-of-box. For production deployments
# see CONFIGURATION-REFERENCE.md.
#
# Storage:   SQLite at /var/lib/kscore/keystone.db (HA needs Postgres)
# Messaging: embedded NATS + JetStream (no external broker required)
# Identity:  disabled (mTLS-based identity requires CA setup)
# TLS:       disabled (enable + provide certs for production)
#
# The HMAC secret below was generated by the package postinstall
# scriptlet on first install. It is unique to this host. Do not
# share. Rotate via an out-of-band secret manager in production.

mode: development

server:
  host: 127.0.0.1
  grpcport: 9090
  httpport: 8080
  tls:
    enabled: false

logging:
  level: info
  format: json

storage:
  driver: sqlite
  dsn: /var/lib/kscore/keystone.db

nats:
  mode: embedded
  jetstream:
    enabled: true
    storedir: /var/lib/kscore/jetstream

identity:
  enabled: false

security:
  hmacsecret: "__HMAC_SECRET__"

metrics:
  enabled: true
  path: /metrics

health:
  startupgraceperiod: 30s
  checktimeout: 2s
