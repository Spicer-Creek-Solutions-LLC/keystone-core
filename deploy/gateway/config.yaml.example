# Keystone Core Telemetry Gateway Configuration
# Copy this file to config.yaml and modify as needed

# NATS connection settings
nats:
  # URL to connect to NATS
  url: "nats://localhost:4222"

  # Optional: Path to CA certificate for TLS
  # ca_cert: "/path/to/ca.crt"

  # Optional: Path to client certificate for mTLS
  # cert: "/path/to/client.crt"

  # Optional: Path to client private key for mTLS
  # key: "/path/to/client.key"

# HTTP server settings
server:
  # Address to listen on
  listen: ":8080"

  # Read timeout
  read_timeout: 30s

  # Write timeout
  write_timeout: 30s

  # Optional: TLS configuration
  # tls:
  #   cert: "/path/to/server.crt"
  #   key: "/path/to/server.key"

# Metrics gateway configuration
metrics:
  # Enable metrics gateway
  enabled: true

  # Maximum staleness age for agent metrics
  max_age: 60s

  # Maximum number of metric series
  max_series: 100000

  # Maximum labels per series
  max_labels_per_series: 20

  # Drop high-cardinality metrics
  drop_high_cardinality: false

  # Threshold for high-cardinality detection
  high_cardinality_threshold: 1000

  # Optional: Remote write to Prometheus-compatible backends
  # remote_write:
  #   - url: "http://prometheus:9090/api/v1/write"
  #     batch_size: 1000
  #     flush_interval: 15s
  #     timeout: 30s
  #     max_retries: 3
  #
  #     # Optional: Headers
  #     headers:
  #       X-Custom-Header: "value"
  #
  #     # Optional: Basic auth
  #     basic_auth:
  #       username: "admin"
  #       password: "secret"
  #
  #     # Optional: Bearer token
  #     bearer_token: "your-token"

  # Label transformations
  # label_transforms:
  #   add:
  #     cluster: "prod-us-east-1"
  #   drop:
  #     - internal_metric
  #   rewrite:
  #     old_name: new_name

# Logs gateway configuration
logs:
  # Enable logs gateway
  enabled: true

  # Maximum number of log entries to keep in memory
  max_entries: 100000

  # Maximum age for log entries
  max_age: 1h

  # Minimum log level to store (debug, info, warn, error)
  min_level: "debug"

  # Only include logs from these sources (empty = all)
  include_sources: []

  # Exclude logs from these sources
  exclude_sources: []

  # Optional: Push to Loki
  # loki:
  #   url: "http://loki:3100/loki/api/v1/push"
  #   batch_size: 100
  #   flush_interval: 5s
  #   timeout: 10s
  #   max_retries: 3
  #
  #   # Optional: Tenant ID for multi-tenant Loki
  #   tenant_id: "default"
  #
  #   # Optional: Basic auth
  #   basic_auth:
  #     username: "admin"
  #     password: "secret"

# Traces gateway configuration
traces:
  # Enable traces gateway
  enabled: true

  # Maximum number of traces to keep in memory
  max_traces: 10000

  # Maximum age for traces
  max_age: 1h

  # Sampling rate (0.0 to 1.0)
  sampling_rate: 1.0

  # Always sample traces with errors
  sample_errors: true

  # Always sample traces slower than this
  slow_threshold: 1s

  # Optional: Export to OTLP endpoint (Tempo, Jaeger, etc.)
  # otlp:
  #   url: "http://tempo:4318/v1/traces"
  #   batch_size: 100
  #   flush_interval: 5s
  #   timeout: 10s
  #   max_retries: 3
  #   use_gzip: true
  #
  #   # Optional: Headers
  #   headers:
  #     X-Custom-Header: "value"

# High availability configuration
ha:
  # Enable HA mode
  enabled: false

  # Instance ID (must be unique per instance)
  instance_id: "gateway-1"

  # Shard count for distributing work
  shard_count: 1

  # Cleanup interval for stale data
  cleanup_interval: 1m
