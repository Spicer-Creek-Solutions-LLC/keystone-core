#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

/t
*.bak

# TitanAnvil specific
build/
data/
*.db
*.db-shm
*.db-wal
titan-anvil.yaml
titan-anvil-agent.yaml
*.creds
*.pem
*.key
*.crt
*.csr
.DS_Store
tmp/
temp/
*.tmp
coverage.out
.idea

# TitanAnvil binaries (in case built to root)
titananvil-server
titananvil-agent
titananvil-exec
titananvil-monitor
titananvil-module
titananvil-state
titananvil-policy
titananvil-gitops
titananvil-registry
titanctl

# Hugo documentation
docs/.hugo_build.lock
docs/node_modules
docs/package-lock.json
docs/resources
docs/pdfs/
