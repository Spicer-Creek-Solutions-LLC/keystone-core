# Shared look for every promo shot. Sourced by each tape via `Source`.
#
# 1920x1080 at FontSize 30 gives roughly 88 columns — wide enough for
# kscorectl's tables without wrapping, large enough to read when the
# video is watched in a timeline preview rather than fullscreen.
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 30
Set Width 1920
Set Height 1080
Set Padding 60
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set WindowBar Colorful
Set BorderRadius 12
